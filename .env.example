# ============================================================
# Shefaa Admin Panel — Environment Configuration
# ============================================================

# Backend provider: "local" (in-memory seed data, no setup required)
# or "supabase" (requires the two keys below).
VITE_BACKEND_PROVIDER=local

# Supabase project credentials (only used when provider = supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
